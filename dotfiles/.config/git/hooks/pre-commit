#!/bin/bash
# pre-commit hook — routing enforcement circuit breaker
# Rejects commits without routing evidence unless explicitly bypassed.
#
# Bypass: SKIP_ROUTING_CHECK=1 git commit ...
# Or: git commit --no-verify (bypasses all hooks)
#
# Baseline: 2026-08-20 — 3 sessions bypassed all soft guards
# P0 fix: removed branch name exemption (complete bypass vector)

set -euo pipefail

# Skip pi-internal repos (checkpoints, sessions, etc.) — not user code
# Check both work-tree AND git-dir because pi-checkpoint uses:
#   --git-dir=~/.pi/.../checkpoints/.../.git --work-tree=/Users/...
# which means rev-parse --show-toplevel returns the work-tree, not the git-dir
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
git_dir="${GIT_DIR:-$(git rev-parse --absolute-git-dir 2>/dev/null || true)}"
if [[ "$repo_root" == "$HOME/.pi"* ]] || [[ "$repo_root" == *"/.pi/"* ]] || \
   [[ "$git_dir" == "$HOME/.pi"* ]] || [[ "$git_dir" == *"/.pi/"* ]]; then
    exit 0
fi

# Allow explicit bypass for emergencies (logged)
if [[ "${SKIP_ROUTING_CHECK:-}" == "1" ]]; then
    echo "⚠️  Routing check bypassed via SKIP_ROUTING_CHECK=1" >&2
    echo "⚠️  Bypass logged at $(date -Iseconds)" >&2
    exit 0
fi

ROUTING_EVIDENCE_FOUND=0

# Method 1: Check staged .md files for ROUTE_CARD
if git diff --cached --name-only | grep -qE '\.(md|txt)$'; then
    if git diff --cached | grep -qE '^\+.*ROUTE_CARD:'; then
        ROUTING_EVIDENCE_FOUND=1
    fi
fi

# Method 2: Check environment for routing context (set by tooling)
if [[ -n "${ROUTE_CARD_ID:-}" ]] || [[ -n "${ROUTED_SESSION:-}" ]]; then
    ROUTING_EVIDENCE_FOUND=1
fi

# Method 3: Check for routing marker file in .pi/
# Tooling can write this file when routing is confirmed
if [[ -f ".pi/routing-confirmed" ]]; then
    ROUTING_EVIDENCE_FOUND=1
fi

# REMOVED: Branch name exemption (P0 bypass vector)
# REMOVED: Small commit exemption (P1 gameable)

if [[ "$ROUTING_EVIDENCE_FOUND" -eq 0 ]]; then
    echo "🛑 No ROUTE_CARD — load workflow-router first (or ROUTED_SESSION=1 / --no-verify)" >&2
    exit 1
fi
